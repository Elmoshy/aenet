<Window x:Class="BatV2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ÆNET" Width="460" Height="720" MinWidth="360" MinHeight="560"
        Background="#000000" Icon="icon.ico" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#0B0B0B" />
        <SolidColorBrush x:Key="CardSel" Color="#161616" />
        <SolidColorBrush x:Key="Stroke" Color="#262626" />
        <SolidColorBrush x:Key="Grey" Color="#8A8A8A" />

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#161616" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="{StaticResource Card}"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1.5"
                                CornerRadius="12" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="Background" Value="{StaticResource CardSel}" />
                                <Setter TargetName="card" Property="BorderBrush" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_Right" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="ÆNET" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Ping all" Click="PingAll_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE77F;" ToolTip="Paste links from clipboard" Click="Add_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE710;" ToolTip="New server by hand" Click="New_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE70F;" ToolTip="Edit selected" Click="Edit_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE896;" ToolTip="Add subscription" Click="Sub_Click" />
                <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Delete selected" Click="Delete_Click" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
            <Border x:Name="Power" Width="140" Height="140" CornerRadius="70" Margin="0,24,0,0"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="3"
                    Cursor="Hand" MouseLeftButtonUp="Power_Up">
                <TextBlock x:Name="PowerIcon" Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="56"
                           Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Status" Text="Disconnected" Foreground="#8A8A8A" FontSize="22"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
            <TextBlock x:Name="SubText" Foreground="#8A8A8A" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock x:Name="ErrText" Foreground="#FF5252" FontSize="12" TextWrapping="Wrap" MaxWidth="360"
                       TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>

        <ListBox x:Name="Lb" MouseDoubleClick="Lb_DoubleClick" Margin="0,16,0,0" Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
                <ContextMenu Background="#0B0B0B" Foreground="White">
                    <MenuItem Header="Edit" Click="Edit_Click" />
                    <MenuItem Header="Ping" Click="PingOne_Click" />
                    <MenuItem Header="Pin certificate" Click="Pin_Click" />
                    <MenuItem Header="Trust any certificate (insecure)" Click="Insecure_Click" />
                    <MenuItem Header="Delete" Click="Delete_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Foreground="#8A8A8A" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Ping}" Foreground="{Binding PingBrush}"
                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
